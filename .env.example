DATABASE_URL=postgres://standwise:standwise@localhost:5433/standwise
TEST_DATABASE_URL=postgres://standwise:standwise@localhost:5433/standwise_test
# Set TRUST_PROXY=true only behind a reverse proxy. The client ip is then read from X-Forwarded-For,
# counting TRUSTED_PROXY_HOPS entries from the right (the proxy-appended one). Railway sits behind
# one proxy: set TRUST_PROXY=true and TRUSTED_PROXY_HOPS=1 in production.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
