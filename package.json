{
  "name": "standwise",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "test": "bun test",
    "db:migrate": "bun packages/db/src/migrate-cli.ts",
    "api": "bun run apps/api/src/main.ts",
    "worker": "bun run apps/worker/src/main.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
